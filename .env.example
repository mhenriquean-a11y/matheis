PORT=3000
DATA_DIR=.data
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
TRUST_PROXY=0

# Publicação gratuita: conexão do Session pooler do Supabase. Nunca envie ao navegador.
